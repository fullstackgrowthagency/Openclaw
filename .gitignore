# macOS / editor noise
.DS_Store
*.swp
*.swo

# Local OpenClaw runtime state should not live in the workspace repo
.openclaw/

# Claude Code's own local tooling state (settings, agent worktrees) --
# machine-local, never project source. Agent worktrees in particular can
# contain entire unrelated checked-out projects.
.claude/

# Secret or machine-local files
.env
**/.env
**/*.key
**/*.pem
**/secrets*

# Business/session scratch files
business/ACTIVE_BUSINESS.json
business/ACTIVE_START_SESSION.json

# GHL local runtime and generated scratch artifacts
ghl-openclaw/data/secrets/
ghl-openclaw/data/generated/
ghl-openclaw/data/taskpacks/
ghl-openclaw/data/approvals/
ghl-openclaw/tmp-*.mjs
ghl-openclaw/tmp-*.json
ghl-openclaw/tmp-*/

# Optional local exports
exports/
backups/
*.tar.gz
*.tgz

# Webull SDK writes a log file (with rotated date-suffixed variants) to
# whatever directory a script using it happens to run from
webull_trade_sdk.log*
