# Copy to .env and fill in. Never commit the real .env (already gitignored at repo root).

# --- Trading mode / safety ---
# sandbox | paper | live. Defaults to sandbox if unset. Start here and stay
# here until the system has been validated extensively in paper mode.
TRADING_MODE=sandbox
APP_ENV=dev

# Live trading requires ALL THREE of these to be set correctly -- this is
# intentionally awkward. Do not set these until you mean it.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=

# --- Webull OpenAPI ---
# app_key/app_secret are tied to a specific environment -- a key issued for
# production will authenticate fine but get rejected with a generic
# "invalid credentials... ensure you are connecting to the correct
# environment" error against the sandbox host, and vice versa. Verified
# live: sandbox host is a bare hostname (no scheme), e.g. api.sandbox.webull.com.
# account_id is one of the accounts returned by account_v2.get_account_list()
# for this app's credentials (e.g. the "Individual Cash" or "Individual
# Margin" sandbox account) -- fetch that list once connected to find it.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_BASE_URL=api.sandbox.webull.com

# --- FMP (Financial Modeling Prep) -- active free-float data provider ---
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable

# --- Massive (free float data) -- alternate/unused unless FMP_API_KEY is unset ---
MASSIVE_API_KEY=
MASSIVE_BASE_URL=

# --- Database (Postgres / Supabase) ---
DATABASE_URL=postgresql+psycopg://webull_bot:webull_bot@localhost:5432/webull_bot

# --- Float data caching ---
FLOAT_CACHE_TTL_HOURS=24
