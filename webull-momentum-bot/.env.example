# Copy to .env and fill in. Never commit the real .env (already gitignored at repo root).

# --- Trading mode / safety ---
# sandbox | paper | live. Defaults to sandbox if unset. Start here and stay
# here until the system has been validated extensively in paper mode.
TRADING_MODE=sandbox
APP_ENV=dev

# Live trading requires ALL THREE of these to be set correctly -- this is
# intentionally awkward. Do not set these until you mean it.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=

# --- Webull OpenAPI ---
# Get current sandbox/production host values from Webull's official OpenAPI
# docs -- they are not hard-coded in this project.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_BASE_URL=

# --- FMP (Financial Modeling Prep) -- active free-float data provider ---
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable

# --- Massive (free float data) -- alternate/unused unless FMP_API_KEY is unset ---
MASSIVE_API_KEY=
MASSIVE_BASE_URL=

# --- Database (Postgres / Supabase) ---
DATABASE_URL=postgresql+psycopg://webull_bot:webull_bot@localhost:5432/webull_bot

# --- Float data caching ---
FLOAT_CACHE_TTL_HOURS=24
