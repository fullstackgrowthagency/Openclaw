# Copy to .env and fill in as later phases need them. Phase 0 only reads
# the two variables below; everything else (broker/connector credentials,
# database, session/encryption keys, live-trading gate) is added by later
# phases -- see docs/ARCHITECTURE.md and the approved plan.

# demo | live -- see config.py's TradingMode. Defaults to demo.
TRADING_MODE=demo

# dev | backtest | staging | prod
APP_ENV=dev
