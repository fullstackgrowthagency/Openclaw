# Copy to .env and fill in as later phases need them. Everything else
# (broker/connector credentials, database, session/encryption keys) is
# added by later phases -- see docs/ARCHITECTURE.md and the approved plan.

# demo | live -- see config.py's TradingMode. Defaults to demo.
TRADING_MODE=demo

# dev | backtest | staging | prod
APP_ENV=dev

# --- Live trading kill-switch (Phase 1). All three conditions in
# Settings.is_live_trading_authorized() must hold before any order can
# reach a real account: TRADING_MODE=live, LIVE_TRADING_ENABLED=true, and
# LIVE_TRADING_CONFIRMATION set to the exact phrase below. Leave these
# unset/false to stay demo-only -- that's the safe default. ---
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRMATION=
