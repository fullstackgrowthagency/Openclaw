# Copy to .env and fill in. This is a developer/CI-friendly stopgap
# config shape, not the end-user experience -- a real Windows
# distribution will need a GUI settings screen or installer-written
# config instead of hand-edited env vars (see docs/ARCHITECTURE.md's
# Phase 5d section).

# The cloud backend's relay WebSocket endpoint.
RELAY_WS_URL=ws://localhost:8765/connector

# The cloud backend's pairing HTTP base URL (used once, at first pairing).
PAIRING_BASE_URL=http://localhost:8000

# Where the paired bearer token/account_id are persisted locally after
# pairing succeeds. Defaults to ~/.fx_connector/credentials.json if unset.
TOKEN_FILE_PATH=

# MT5 terminal login. If left unset, initialize() falls back to whatever
# account is already logged into the terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Some brokers append a suffix to symbol names (e.g. "EURUSD.m") --
# leave blank unless your broker/terminal actually does this.
MT5_SYMBOL_SUFFIX=

QUOTE_POLL_INTERVAL_SECONDS=1.0
HEARTBEAT_INTERVAL_SECONDS=15.0
